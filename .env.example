# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Kaggle (for IEEE-CIS / DGraph-Fin downloads)
KAGGLE_USERNAME=
KAGGLE_KEY=

# data.gov.in (for RBI-published datasets via their API)
DATA_GOV_IN_API_KEY=

# OpenAI (primary) for the "Ask your data" text-to-SQL feature
OPENAI_API_KEY=

# Gemini (fallback if OpenAI errors/rate-limits)
GEMINI_API_KEY=

# Hugging Face (fallback if both OpenAI and Gemini fail) — genuinely free,
# no billing card needed. Get a token at huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Password for the read-only Postgres role used by Ask-your-data — set this
# to whatever you choose, then run: uv run python -m backend.services.setup_readonly_role
READONLY_DB_PASSWORD=changeme_readonly

# --- Security / deployment ---
# development (default) or production. Production hides /docs and refuses the default read-only DB password.
APP_ENV=development
# Comma-separated browser origins allowed to call the API (no wildcard). Add your deployed frontend URL here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true ONLY when running behind a trusted reverse proxy (NGINX etc.) so rate limits use the real client IP.
TRUST_PROXY=false

# Optional: share rate limits across several workers/servers (leave empty for single-process).
RATE_LIMIT_REDIS_URL=
# Behind a trusted HTTPS proxy only: redirect http -> https (needs TRUST_PROXY=true).
FORCE_HTTPS=false
