# /etc/apexfi.env  - settings for the ApexFi API service (keep this file private: chmod 600)
DATA_BACKEND=duckdb
GOLD_PARQUET_DIR=/opt/apexfi/data/gold_parquet
APP_ENV=production
TRUST_PROXY=1
PORT=8000

# your Vercel address(es), comma separated, no trailing slash
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app

# private Hugging Face repos + a READ token
HF_MODEL_REPO=karthifde/apexfi-models
HF_DATA_REPO=karthifde/apexfi-data
HF_TOKEN=PASTE_READ_TOKEN_HERE

# free LLM providers for "Ask your data" (any one is enough; leave the rest empty)
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

ASK_DAILY_CAP=500
# keep some RAM free for the models: this server has 12 GB
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=2
